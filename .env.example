# Journal Report AI chat orchestration (Supabase Edge Function ai-analyze secrets)
# MOONSHOT_API_KEY / KIMI_API_KEY: numeric answers (always)
# PERPLEXITY_API_KEY: web search for strategy/countermeasure questions
# XAI_API_KEY / GROK_API_KEY: X/trend briefs for strategy questions
# PERPLEXITY_MODEL=sonar
# JOURNAL_GROK_X_SEARCH_MODEL=grok-4.5
# GROK_X_SEARCH_LOOKBACK_DAYS=30
# GROK_X_SEARCH_MAX_TOOL_CALLS=4
# GROK_X_SEARCH_TIMEOUT_MS=45000
MOONSHOT_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_TIMEOUT_MS=5000
GEMINI_MAX_CANDIDATES=3
GEMINI_WINE_FLOW_ENABLED=true
GEMINI_WINE_ANALYSIS_MODEL=gemini-2.0-flash-lite
GEMINI_WINE_REPLY_MODEL=gemini-2.0-flash-lite
GEMINI_WINE_TIMEOUT_MS=12000
